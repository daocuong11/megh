import { describe, expect, it } from 'vitest';
import { validateDto } from '@meghjs/core';
import { {ClassName} } from '{import}';

describe('{ClassName}', () => {
  it('accepts a valid body', () => {
    const { errors } = validateDto({ClassName}, { name: 'Name', description: 'Description' });

    expect(errors).toBeNull();
  });

  it('requires a name', () => {
    const { errors } = validateDto({ClassName}, {});

    expect(errors?.map((e) => e.path)).toEqual(['name']);
  });
});
